# Token from @BotFather after creating your bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Chat where files will be stored. Can be:
# - your own user id (DM the bot first, e.g. via @userinfobot)
# - a private group/channel id the bot is admin of (starts with -100...)
TELEGRAM_CHAT_ID=-1000000000000

# Shared secret required to use the web UI / API (choose your own strong value)
APP_PASSWORD=change-me

# Port the web server listens on
PORT=3000
